<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wheelhouse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Wheelhouse">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
      <div class="container">
        <%= link_to "Wheelhouse", root_path, class: "navbar-brand" %>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <div class="navbar-nav">
            <%= link_to "Home", root_path,
              class: "nav-link #{'active' if current_page?(root_path)}" %>

            <%= link_to "Customers", customers_path,
              class: "nav-link #{'active' if current_page?(customers_path)}" %>

            <%= link_to "Bikes", bikes_path,
              class: "nav-link #{'active' if current_page?(bikes_path)}" %>

            <%= link_to "Repairs", repairs_path,
              class: "nav-link #{'active' if current_page?(repairs_path)}" %>

            <%= link_to "Services", services_path,
              class: "nav-link #{'active' if current_page?(services_path)}" %>

            <%= link_to "Staff", staff_index_path,
              class: "nav-link #{'active' if current_page?(staff_index_path)}" %>

            <%= link_to "Visit", visit_path,
              class: "nav-link #{'active' if current_page?(visit_path)}" %>

            <%= link_to "About", about_path,
              class: "nav-link #{'active' if current_page?(about_path)}" %>
        </div>
      </div>
    </nav>

          
      <% flash.each do |type, message| %>
        <% bootstrap_class = type.to_s == "notice" ? "success" : "danger" %>

        <div class="container mt-3">
          <div class="alert alert-<%= bootstrap_class %> alert-dismissible fade show" role="alert">
            <%= message %>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
          </div>
        </div>
      <% end %>

    <main class="container py-4">
      <%= yield %>
    </main>
  </body>
</html>
