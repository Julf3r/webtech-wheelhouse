<h1><%= @customer.name %></h1>

<p><strong>Phone:</strong> <%= @customer.phone %></p>

<h2>Bikes</h2>

<% if @customer.bikes.any? %>
  <%= render @customer.bikes %>
<% else %>
  <p>This customer has no bikes.</p>
<% end %>

<%= link_to "Back to customers", customers_path, class: "btn btn-secondary" %>