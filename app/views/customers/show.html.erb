<h1><%= @customer.name %></h1>

<p><strong>Phone:</strong> <%= @customer.phone %></p>

<h2>Bikes</h2>

<% if @customer.bikes.any? %>
  <%= render @customer.bikes %>
<% else %>
  <p>This customer has no bikes.</p>
<% end %>

<%= link_to "Back to customers", customers_path, class: "btn btn-secondary" %>

<div class="d-flex gap-2 mt-4">
  <%= link_to "Add Bike",
      new_bike_path(customer_id: @customer.id),
      class: "btn btn-primary" %>

  <%= link_to "Edit Customer",
      edit_customer_path(@customer),
      class: "btn btn-outline-primary" %>

  <%= button_to "Delete Customer",
      customer_path(@customer),
      method: :delete,
      class: "btn btn-danger",
      form: {
        data: {
          turbo_confirm: "Are you sure you want to delete this customer?"
        }
      } %>

  <%= link_to "Back", customers_path,
      class: "btn btn-secondary" %>
</div>