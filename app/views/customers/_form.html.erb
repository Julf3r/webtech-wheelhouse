<%= form_with model: customer do |form| %>
  <% if customer.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% customer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% [:name, :phone].each do |field| %>
    <div class="mb-3">
      <%= form.label field, class: "form-label" %>
      <%= form.text_field field,
          class: "form-control #{'is-invalid' if customer.errors[field].any?}" %>

      <% customer.errors[field].each do |message| %>
        <div class="invalid-feedback d-block">
          <%= message %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= form.submit class: "btn btn-primary" %>
<% end %>