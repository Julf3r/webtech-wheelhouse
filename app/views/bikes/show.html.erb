<h1><%= @bike.make %> <%= @bike.model %></h1>

<p><strong>Color:</strong> <%= @bike.color %></p>
<p><strong>Serial number:</strong> <%= @bike.serial_number %></p>
<p>
  <strong>Owner:</strong>
  <%= link_to @bike.customer.name, customer_path(@bike.customer) %>
</p>


<h2 class="mt-4">Repairs</h2>

<table class="table table-striped">
  <thead>
    <tr>
      <th>ID</th>
      <th>Bike</th>
      <th>Status</th>
      <th>Photo</th>
      <th>Diagnosis</th>
    </tr>
  </thead>

  <tbody>
    <%= render partial: "repairs/repair_row",
        collection: @bike.repairs,
        as: :repair %>
  </tbody>
</table>


<%= link_to "Back to bikes", bikes_path, class: "btn btn-secondary" %>

<div class="d-flex gap-2 mt-4">
  <%= link_to "New Repair",
      new_repair_path(bike_id: @bike.id),
      class: "btn btn-primary" %>

  <%= link_to "Edit Bike",
      edit_bike_path(@bike),
      class: "btn btn-outline-primary" %>

  <%= button_to "Delete Bike",
      bike_path(@bike),
      method: :delete,
      class: "btn btn-danger",
      form: {
        data: {
          turbo_confirm: "Are you sure you want to delete this bike?"
        }
      } %>

  <%= link_to "Back", bikes_path,
      class: "btn btn-secondary" %>
</div>