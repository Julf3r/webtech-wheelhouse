<h1><%= @bike.make %> <%= @bike.model %></h1>

<p><strong>Color:</strong> <%= @bike.color %></p>
<p><strong>Serial number:</strong> <%= @bike.serial_number %></p>
<p>
  <strong>Owner:</strong>
  <%= link_to @bike.customer.name, customer_path(@bike.customer) %>
</p>


<h2 class="mt-4">Repairs</h2>

<table class="table table-striped">
  <thead>
    <tr>
      <th>ID</th>
      <th>Bike</th>
      <th>Status</th>
      <th>Photo</th>
      <th>Diagnosis</th>
    </tr>
  </thead>

  <tbody>
    <%= render partial: "repairs/repair_row",
        collection: @repairs,
        as: :repair %>
  </tbody>
</table>


<%= link_to "Back to bikes", bikes_path, class: "btn btn-secondary" %>

<% if policy(Repair).create? %>
  <%= link_to "New Repair",
      new_repair_path(bike_id: @bike.id),
      class: "btn btn-primary" %>
<% end %>

<% if policy(@bike).update? %>
  <%= link_to "Edit Bike",
      edit_bike_path(@bike),
      class: "btn btn-outline-primary" %>
<% end %>

<% if policy(@bike).destroy? %>
  <%= button_to "Delete Bike",
      bike_path(@bike),
      method: :delete,
      class: "btn btn-danger",
      form: { data: { turbo_confirm: "Are you sure?" } } %>
<% end %>