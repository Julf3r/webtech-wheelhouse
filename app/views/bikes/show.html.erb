<h1><%= @bike.make %> <%= @bike.model %></h1>

<p><strong>Color:</strong> <%= @bike.color %></p>
<p><strong>Serial number:</strong> <%= @bike.serial_number %></p>
<p>
  <strong>Owner:</strong>
  <%= link_to @bike.customer.name, customer_path(@bike.customer) %>
</p>

<h2>Repairs</h2>

<% if @bike.repairs.any? %>
  <ul>
    <% @bike.repairs.each do |repair| %>
      <li>
        <%= link_to "#{repair.status} — #{repair.received_at.to_date}",
                    repair_path(repair) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No repairs recorded.</p>
<% end %>

<%= link_to "Back to bikes", bikes_path, class: "btn btn-secondary" %>

<div class="d-flex gap-2 mt-4">
  <%= link_to "New Repair",
      new_repair_path(bike_id: @bike.id),
      class: "btn btn-primary" %>

  <%= link_to "Edit Bike",
      edit_bike_path(@bike),
      class: "btn btn-outline-primary" %>

  <%= button_to "Delete Bike",
      bike_path(@bike),
      method: :delete,
      class: "btn btn-danger",
      form: {
        data: {
          turbo_confirm: "Are you sure you want to delete this bike?"
        }
      } %>

  <%= link_to "Back", bikes_path,
      class: "btn btn-secondary" %>
</div>