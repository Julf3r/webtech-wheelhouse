<h1>Bikes</h1>
<%= link_to "New Bike", new_bike_path, class: "btn btn-primary mb-3" %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Bike</th>
      <th>Color</th>
      <th>Owner</th>
    </tr>
  </thead>
  <tbody>
    <% @bikes.each do |bike| %>
      <tr>
        <td><%= link_to "#{bike.make} #{bike.model}", bike_path(bike) %></td>
        <td><%= bike.color %></td>
        <td><%= link_to bike.customer.name, customer_path(bike.customer) %></td>
      </tr>
    <% end %>
  </tbody>
</table>