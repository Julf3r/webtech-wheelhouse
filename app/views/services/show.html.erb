<h1><%= @service.name %></h1>

<p>
  <strong>Current price:</strong>
  <%= number_to_currency(@service.current_price, unit: "$", precision: 0) %>
</p>

<%= link_to "Back to services", services_path, class: "btn btn-secondary" %>
<div class="d-flex gap-2 mt-4">
  <%= link_to "Edit Service",
      edit_service_path(@service),
      class: "btn btn-primary" %>

  <%= button_to "Delete Service",
      service_path(@service),
      method: :delete,
      class: "btn btn-danger",
      form: {
        data: {
          turbo_confirm: "Are you sure you want to delete this service?"
        }
      } %>

  <%= link_to "Back", services_path,
      class: "btn btn-secondary" %>
</div>