
<div class="container py-4">
  <h1>Repair #<%= @repair.id %></h1>

  <p>
    <strong>Bike:</strong>
    <%= link_to "#{@repair.bike.make} #{@repair.bike.model}",
                bike_path(@repair.bike) %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= @repair.status.humanize %>
  </p>

  <p>
    <strong>Received:</strong>
    <%= @repair.received_at&.to_date || "Not specified" %>
  </p>

  <p>
    <strong>Promised:</strong>
    <%= @repair.promised_on || "Not specified" %>
  </p>

  <p>
    <strong>Mechanic:</strong>
    <% if @repair.mechanic %>
      <%= link_to @repair.mechanic.name,
                  staff_path(@repair.mechanic) %>
    <% else %>
      Not assigned
    <% end %>
  </p>

  <p>
    <strong>Intake condition:</strong>
    <%= @repair.intake_condition.presence || "Not specified" %>
  </p>

  <p>
    <strong>Quoted price:</strong>
    <% if @repair.quoted_price %>
      <%= number_to_currency(@repair.quoted_price,
                             unit: "$", precision: 0) %>
    <% else %>
      Not quoted
    <% end %>
  </p>

  <p>
    <strong>Customer decision:</strong>
    <%= @repair.customer_decision&.humanize || "Pending" %>
  </p>

  <p>
    <strong>Handed back:</strong>
    <%= @repair.handed_back_at&.to_date || "Not yet" %>
  </p>

  <h2 class="mt-4">Services</h2>

  <% if @repair.repair_services.any? %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Service</th>
          <th>Charged price</th>
        </tr>
      </thead>

      <tbody>
        <% @repair.repair_services.each do |repair_service| %>
          <tr>
            <td>
              <%= link_to repair_service.service.name,
                          service_path(repair_service.service) %>
            </td>
            <td>
              <%= number_to_currency(
                    repair_service.charged_price,
                    unit: "$",
                    precision: 0
                  ) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p class="fw-bold">
      Total:
      <%= number_to_currency(
            @repair.repair_services.sum(&:charged_price),
            unit: "$",
            precision: 0
          ) %>
    </p>
  <% else %>
    <p>No services assigned.</p>
  <% end %>

  
  <hr>

  <h2>Diagnosis</h2>

  <% if @repair.diagnosis.present? %>
    <div class="mb-4">
      <%= @repair.diagnosis %>
    </div>
  <% else %>
    <p>No diagnosis recorded.</p>
  <% end %>

  <h2>Intake Photos</h2>

  <% if @repair.intake_photos.attached? %>
    <div class="d-flex flex-wrap gap-3 mb-4">
      <% @repair.intake_photos.each do |photo| %>
        <%= link_to url_for(photo), target: "_blank",
            rel: "noopener" do %>
          <%= image_tag photo.variant(:display),
              alt: "Intake photo of #{@repair.bike.make} #{@repair.bike.model}, repair ##{@repair.id}",
              class: "img-fluid rounded",
              style: "max-width: 300px;" %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p>No intake photos uploaded.</p>
  <% end %>


  <div class="d-flex gap-2 mt-4">
    <%= link_to "Edit Repair",
                edit_repair_path(@repair),
                class: "btn btn-primary" %>

    <%= button_to "Delete Repair",
                  repair_path(@repair),
                  method: :delete,
                  class: "btn btn-danger",
                  form: {
                    data: {
                      turbo_confirm: "Are you sure you want to delete this repair?"
                    }
                  } %>

    <%= link_to "Back",
                repairs_path,
                class: "btn btn-secondary" %>
  </div>
</div>
