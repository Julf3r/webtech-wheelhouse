<h1>Repairs</h1>
<%= link_to "New Repair", new_repair_path, class: "btn btn-primary mb-3" %>


<div class="container py-4">
  <h1>Repairs</h1>

  <%= link_to "New Repair", new_repair_path,
      class: "btn btn-primary mb-3" %>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>ID</th>
        <th>Bike</th>
        <th>Status</th>
        <th>Photo</th>
        <th>Diagnosis</th>
      </tr>
    </thead>

    <tbody>
      <%= render partial: "repair_row",
          collection: @repairs,
          as: :repair %>
    </tbody>
  </table>
</div>
