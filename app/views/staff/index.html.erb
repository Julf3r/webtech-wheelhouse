<h1>Staff</h1>
<% if policy(Staff).create? %>
  <%= link_to "New Staff Member", new_staff_path,
      class: "btn btn-primary mb-3" %>
<% end %>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Role</th>
    </tr>
  </thead>

  <tbody>
    <% @staff.each do |member| %>
      <tr>
        <td><%= link_to member.name, staff_path(member) %></td>
        <td><%= member.role %></td>
      </tr>
    <% end %>
  </tbody>
</table>