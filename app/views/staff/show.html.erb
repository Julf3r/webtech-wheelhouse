<h1><%= @staff_member.name %></h1>

<p><strong>Role:</strong> <%= @staff_member.role %></p>

<% if @staff_member.role == "Mechanic" %>
  <h2>Repairs</h2>

  <% if @staff_member.repairs.any? %>
    <ul>
      <% @staff_member.repairs.each do |repair| %>
        <li>
          <%= link_to "#{repair.bike.make} #{repair.bike.model} — #{repair.status.humanize}",
                      repair_path(repair) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No repairs assigned.</p>
  <% end %>
<% end %>

<%= link_to "Back to staff", staff_index_path, class: "btn btn-secondary" %>
<div class="d-flex gap-2 mt-4">
  <%= link_to "Edit Staff Member",
      edit_staff_path(@staff_member),
      class: "btn btn-primary" %>

  <%= button_to "Delete Staff Member",
      staff_path(@staff_member),
      method: :delete,
      class: "btn btn-danger",
      form: {
        data: {
          turbo_confirm: "Are you sure you want to delete this staff member?"
        }
      } %>

  <%= link_to "Back", staff_index_path,
      class: "btn btn-secondary" %>
</div>